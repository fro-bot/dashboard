{
  "name": "@fro-bot/dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Fro Bot monitoring dashboard with an isolated wiki-write capability",
  "type": "module",
  "workspaces": [
    "wiki-writer"
  ],
  "scripts": {
    "bootstrap": "bun install",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:fixture": "bun run build:web:fixture && NODE_ENV=development DASHBOARD_HOST=127.0.0.1 DASHBOARD_WEB_DIST=./web/dist-fixture DASHBOARD_FIXTURE_HARNESS_ENABLED=true DASHBOARD_DEV_AUTOLOGIN=true node --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "build:web": "vite build web",
    "build:web:fixture": "VITE_FIXTURE_MODE=true vite build web",
    "check-types": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p .opencode/tsconfig.json",
    "lint": "eslint",
    "fix": "eslint --fix",
    "pretest": "bun run build:web",
    "test": "vitest run && vitest run --config web/vitest.config.ts"
  },
  "overrides": {
    "brace-expansion@2": ">=2.1.2 <6.0.0",
    "brace-expansion@5": ">=5.0.12 <6.0.0",
    "fast-uri@3": ">=3.1.5 <4.0.0",
    "katex@0": ">=0.18.2 <1.0.0",
    "toml@4": ">=4.2.0 <5.0.0",
    "undici@7": ">=7.29.0 <8.0.0"
  },
  "dependencies": {
    "@bfra.me/es": "0.1.0",
    "@hono/node-server": "^2.0.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@octokit/graphql": "9.0.5",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "hono": "^4.7.11",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@bfra.me/eslint-config": "0.54.0",
    "@bfra.me/tsconfig": "0.13.2",
    "@opencode-ai/plugin": "1.19.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.13.0",
    "eslint-plugin-erasable-syntax-only": "0.7.2",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24"
  }
}
